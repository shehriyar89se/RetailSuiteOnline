@inherits LayoutComponentBase

@inject AuthService Auth
@inject NavigationManager Nav
@implements IDisposable

<Toast />

@if (!_checked)
{
    <div style="display:flex;align-items:center;justify-content:center;height:100vh;background:#f9fafb;">
        <div class="spinner"></div>
    </div>
}
else if (!Auth.IsAuthenticated)
{
    <div style="display:flex;align-items:center;justify-content:center;height:100vh;background:#f9fafb;">
        <p style="color:#9ca3af;">Redirecting to login...</p>
    </div>
}
else
{
    <div class="layout">

        <div class="sidebar-backdrop @( _sidebarOpen ? "open" : "")" @onclick="() => _sidebarOpen = false"></div>

        <div class="sidebar @( _sidebarOpen ? "open" : "")">
            <h2>RetailSuite</h2>

            @if (Auth.IsSuperAdmin)
            {
                <span style="font-size:11px;text-transform:uppercase;color:#9ca3af;letter-spacing:.05em;margin:8px 0 4px;display:block;">Platform</span>
                <NavLink href="/admin/tenants" style="color:#fbbf24;">🏢 Tenant Management</NavLink>
                <NavLink href="/admin/plans" style="color:#fbbf24;">💳 Subscription Plans</NavLink>
                <hr style="border:none;border-top:1px solid #374151;margin:12px 0;" />
            }
            else
            {
                <NavLink href="@AP("")" Match="NavLinkMatch.All">📊 Dashboard</NavLink>

                <!-- Selling -->
                @if (Auth.Can("POS") || Auth.Can("ORDERS_VIEW") || Auth.Can("CUSTOMERS"))
                {
                    <button type="button" @onclick='@(() => Toggle("selling"))' style="@HeaderStyle(IsOpen("selling"))">
                        <span style="width:20px;text-align:center;">🛒</span>
                        <span>Selling</span>
                        <span style="margin-left:auto;font-size:10px;color:#9ca3af;transform:@(IsOpen("selling") ? "rotate(90deg)" : "none");display:inline-block;">›</span>
                    </button>
                    @if (IsOpen("selling"))
                    {
                        <div style="padding-left:10px;padding-bottom:4px;">
                            @if (Auth.Can("POS"))         { <NavLink href="@AP("pos")">POS Terminal</NavLink> }
                            @if (Auth.Can("ORDERS_VIEW")) { <NavLink href="@AP("orders")">Orders</NavLink> }
                            @if (Auth.Can("CUSTOMERS"))   { <NavLink href="@AP("customers")">Customers</NavLink> }
                        </div>
                    }
                }

                <!-- Catalog -->
                @if (Auth.Can("PRODUCTS") || Auth.Can("INVENTORY_VIEW")
                  || Auth.Can("INVENTORY_TRANSFER") || Auth.Can("BARCODES"))
                {
                    <button type="button" @onclick='@(() => Toggle("catalog"))' style="@HeaderStyle(IsOpen("catalog"))">
                        <span style="width:20px;text-align:center;">📚</span>
                        <span>Catalog</span>
                        <span style="margin-left:auto;font-size:10px;color:#9ca3af;transform:@(IsOpen("catalog") ? "rotate(90deg)" : "none");display:inline-block;">›</span>
                    </button>
                    @if (IsOpen("catalog"))
                    {
                        <div style="padding-left:10px;padding-bottom:4px;">
                            @if (Auth.Can("PRODUCTS"))           { <NavLink href="@AP("products")">Products</NavLink> }
                            @if (Auth.Can("INVENTORY_VIEW"))     { <NavLink href="@AP("inventory")">Inventory</NavLink> }
                            @if (Auth.Can("INVENTORY_TRANSFER")) { <NavLink href="@AP("inventory/transfers")">Stock transfers</NavLink> }
                            @if (Auth.Can("BARCODES"))           { <NavLink href="@AP("barcodes/print")">Print barcodes</NavLink> }
                        </div>
                    }
                }

                <!-- Procurement -->
                @if (Auth.Can("SUPPLIERS") || Auth.Can("RECEIVING_ORDERS")
                  || Auth.Can("BULK_RECEIVE") || Auth.Can("SUPPLIER_RETURNS"))
                {
                    <button type="button" @onclick='@(() => Toggle("procurement"))' style="@HeaderStyle(IsOpen("procurement"))">
                        <span style="width:20px;text-align:center;">📦</span>
                        <span>Procurement</span>
                        <span style="margin-left:auto;font-size:10px;color:#9ca3af;transform:@(IsOpen("procurement") ? "rotate(90deg)" : "none");display:inline-block;">›</span>
                    </button>
                    @if (IsOpen("procurement"))
                    {
                        <div style="padding-left:10px;padding-bottom:4px;">
                            @if (Auth.Can("SUPPLIERS"))        { <NavLink href="@AP("suppliers")">Suppliers</NavLink> }
                            @if (Auth.Can("RECEIVING_ORDERS")) { <NavLink href="@AP("receiving-orders")">Receiving orders</NavLink> }
                            @if (Auth.Can("BULK_RECEIVE"))     { <NavLink href="@AP("inventory/bulk-receive")">Bulk receive</NavLink> }
                            @if (Auth.Can("SUPPLIER_RETURNS")) { <NavLink href="@AP("supplier-returns")">Supplier returns</NavLink> }
                        </div>
                    }
                }

                <!-- Reports -->
                @if (Auth.Can("REPORTS"))
                {
                    <button type="button" @onclick='@(() => Toggle("reports"))' style="@HeaderStyle(IsOpen("reports"))">
                        <span style="width:20px;text-align:center;">📈</span>
                        <span>Reports</span>
                        <span style="margin-left:auto;font-size:10px;color:#9ca3af;transform:@(IsOpen("reports") ? "rotate(90deg)" : "none");display:inline-block;">›</span>
                    </button>
                    @if (IsOpen("reports"))
                    {
                        <div style="padding-left:10px;padding-bottom:4px;">
                            <NavLink href="@AP("reports")">Sales &amp; inventory</NavLink>
                        </div>
                    }
                }

                <!-- Accounting -->
                @if (Auth.Can("ACCOUNTING"))
                {
                    <button type="button" @onclick='@(() => Toggle("accounting"))' style="@HeaderStyle(IsOpen("accounting"))">
                        <span style="width:20px;text-align:center;">💰</span>
                        <span>Accounting</span>
                        <span style="margin-left:auto;font-size:10px;color:#9ca3af;transform:@(IsOpen("accounting") ? "rotate(90deg)" : "none");display:inline-block;">›</span>
                    </button>
                    @if (IsOpen("accounting"))
                    {
                        <div style="padding-left:10px;padding-bottom:4px;">
                            <NavLink href="@AP("accounting/trial-balance")">Trial balance</NavLink>
                            <NavLink href="@AP("accounting/journal-entries")">Journal entries</NavLink>
                            <NavLink href="@AP("accounting/chart-of-accounts")">Chart of accounts</NavLink>
                            <NavLink href="@AP("accounting/post-journal")">+ Post manual entry</NavLink>
                            @if (Auth.IsAdmin)
                            {
                                <NavLink href="@AP("accounting/daily-ledger")">Daily ledger</NavLink>
                            }
                        </div>
                    }
                }

                <!-- Settings -->
                @if (Auth.Can("LOCATIONS") || Auth.Can("SHIPPING") || Auth.Can("TAX_SETTINGS")
                  || Auth.Can("SUBSCRIPTION") || Auth.Can("CATEGORIES") || Auth.Can("BRANDS")
                  || Auth.Can("ATTRIBUTES") || Auth.IsAdmin)
                {
                    <button type="button" @onclick='@(() => Toggle("settings"))' style="@HeaderStyle(IsOpen("settings"))">
                        <span style="width:20px;text-align:center;">⚙️</span>
                        <span>Settings</span>
                        <span style="margin-left:auto;font-size:10px;color:#9ca3af;transform:@(IsOpen("settings") ? "rotate(90deg)" : "none");display:inline-block;">›</span>
                    </button>
                    @if (IsOpen("settings"))
                    {
                        <div style="padding-left:10px;padding-bottom:4px;">
                            @if (Auth.Can("CATEGORIES"))   { <NavLink href="@AP("settings/categories")">Categories</NavLink> }
                            @if (Auth.Can("BRANDS"))       { <NavLink href="@AP("settings/brands")">Brands</NavLink> }
                            @if (Auth.Can("ATTRIBUTES"))   { <NavLink href="@AP("settings/attributes")">Attributes</NavLink> }
                            @if (Auth.Can("LOCATIONS"))    { <NavLink href="@AP("locations")">Locations</NavLink> }
                            @if (Auth.Can("SHIPPING"))     { <NavLink href="@AP("settings/shipping-methods")">Shipping methods</NavLink> }
                            @if (Auth.Can("TAX_SETTINGS")) { <NavLink href="@AP("settings/tax")">Tax &amp; FBR</NavLink> }
                            @if (Auth.Can("SUBSCRIPTION")) { <NavLink href="@AP("settings/subscription")">Subscription</NavLink> }
                            @if (Auth.IsAdmin)             { <NavLink href="@AP("settings/users")">Users &amp; permissions</NavLink> }
                        </div>
                    }
                }

                <hr style="border:none;border-top:1px solid #374151;margin:12px 0;" />
                @if (!string.IsNullOrEmpty(Auth.TenantSubdomain))
                {
                    <NavLink href="@($"/store/{Auth.TenantSubdomain}")" style="color:#6ee7b7;">🛍 Storefront</NavLink>
                }
            }
        </div>

        <!-- Main -->
        <div class="main">
            <div class="header">
                <button class="header-burger" @onclick="() => _sidebarOpen = !_sidebarOpen" title="Menu">☰</button>

                @if (Auth.IsSuperAdmin)
                {
                    <span style="font-weight:600;color:#d97706;flex:1;">⭐ Super Admin Portal</span>
                }
                else
                {
                    <span style="font-weight:500;color:#374151;flex:1;">Admin Panel</span>
                }

                <button class="btn btn-danger" @onclick="LogoutAsync">Logout</button>
            </div>

            <div class="content">
                @Body
            </div>

            <div class="footer">
                © @DateTime.Now.Year RetailSuite
            </div>
        </div>
    </div>
}

@code {
    private bool _checked;
    private bool _sidebarOpen;

    private HashSet<string> _openGroups = new()
    {
        "selling", "catalog", "procurement", "reports", "accounting", "settings"
    };

    private bool IsOpen(string key) => _openGroups.Contains(key);

    /// <summary>Build a tenant-scoped admin path, e.g. AP("orders") -> "/demo-store/admin/orders".</summary>
    private string AP(string relative) =>
        string.IsNullOrEmpty(relative)
            ? $"/{Auth.TenantSubdomain}/admin"
            : $"/{Auth.TenantSubdomain}/admin/{relative}";

    private void Toggle(string key)
    {
        if (_openGroups.Contains(key)) _openGroups.Remove(key);
        else                            _openGroups.Add(key);
    }

    private string HeaderStyle(bool open) =>
        "display:flex;align-items:center;gap:8px;cursor:pointer;padding:8px 10px;margin:4px 0;"
        + "border-radius:6px;color:#e5e7eb;font-weight:500;font-size:14px;"
        + "user-select:none;background:" + (open ? "#374151" : "transparent") + ";"
        + "border:none;width:100%;text-align:left;";

    protected override void OnInitialized()
    {
        Auth.OnChange += StateHasChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        await Auth.InitializeAsync();
        _checked = true;

        if (!Auth.IsAuthenticated)
            Nav.NavigateTo("/login", replace: true);

        StateHasChanged();
    }

    async Task LogoutAsync()
    {
        await Auth.LogoutAsync();
        Nav.NavigateTo("/login", replace: true);
    }

    public void Dispose()
    {
        Auth.OnChange -= StateHasChanged;
    }
}
