@page "/admin/tenants"
@layout MainLayout
@inject HttpClient Http
@inject AuthService AuthSvc
@inject NavigationManager Nav
@inject ToastService Toast
@inject IJSRuntime JS
@using System.Text.Json

@code {
    // ----------- state -----------
    bool   _loading       = true;
    bool   _showCreate    = false;
    bool   _creating      = false;
    bool   _showArchived  = false;
    string _search        = string.Empty;

    List<TenantRow> _tenants = new();

    // Create-tenant form fields
    string _newName     = string.Empty;
    string _newSubdomain = string.Empty;
    string _newEmail    = string.Empty;
    string _newPlanCode = string.Empty; // "" = no plan assigned at creation
    string _newCycle    = "Monthly";
    List<PlanOption> _plans = new();

    // Result of last creation (shown in a success box)
    CreatedResult? _lastCreated;

    // Edit-tenant form state
    Guid?  _editingId;
    bool   _saving;
    string _editName         = string.Empty;
    string _editSubdomain    = string.Empty;
    string _editBillingEmail = string.Empty;
    string _editCountryCode  = string.Empty;
    string _editAdminEmail   = string.Empty; // the tenant's admin login email — distinct from BillingEmail
    string _originalAdminEmail = string.Empty;
    bool   _loadingAdminEmail;

    IEnumerable<TenantRow> Filtered =>
        string.IsNullOrWhiteSpace(_search)
            ? _tenants
            : _tenants.Where(t =>
                t.Name.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
                t.Subdomain.Contains(_search, StringComparison.OrdinalIgnoreCase));

    protected override void OnInitialized()
    {
        // Guard: only super admin may view this page
        if (!AuthSvc.IsSuperAdmin)
        {
            Nav.NavigateTo("/", replace: true);
            return;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadTenantsAsync();
            await LoadPlansAsync();
        }
    }

    async Task LoadPlansAsync()
    {
        try
        {
            var json = await Http.GetStringAsync("api/subscriptions/plans");
            using var doc = JsonDocument.Parse(json);
            var arr = doc.RootElement.TryGetProperty("data", out var d) ? d : doc.RootElement;

            _plans.Clear();
            if (arr.ValueKind == JsonValueKind.Array)
            {
                foreach (var p in arr.EnumerateArray())
                {
                    _plans.Add(new PlanOption
                    {
                        Code         = p.GetProperty("code").GetString() ?? "",
                        Name         = p.GetProperty("name").GetString() ?? "",
                        MonthlyPrice = p.GetProperty("monthlyPrice").GetDecimal(),
                        YearlyPrice  = p.GetProperty("yearlyPrice").GetDecimal()
                    });
                }
            }
        }
        catch { /* non-fatal — plan dropdown just stays empty, plan can still be assigned later */ }
    }

    async Task LoadTenantsAsync()
    {
        _loading = true;
        try
        {
            var url  = _showArchived ? "api/tenants?includeArchived=true" : "api/tenants";
            var json = await Http.GetStringAsync(url);
            using var doc = JsonDocument.Parse(json);
            var arr = doc.RootElement.TryGetProperty("data", out var d) ? d : doc.RootElement;

            _tenants.Clear();
            if (arr.ValueKind == JsonValueKind.Array)
            {
                foreach (var t in arr.EnumerateArray())
                {
                    _tenants.Add(new TenantRow
                    {
                        Id            = t.TryGetProperty("id",            out var id)  ? id.GetGuid()     : Guid.Empty,
                        Name          = t.TryGetProperty("name",          out var nm)  ? nm.GetString()!  : "—",
                        Subdomain     = t.TryGetProperty("subdomain",     out var sd)  ? sd.GetString()!  : "—",
                        Status        = t.TryGetProperty("status",       out var st)   ? st.GetString()!  : "Unknown",
                        BillingEmail  = t.TryGetProperty("billingEmail", out var be) && be.ValueKind == JsonValueKind.String ? be.GetString() : null,
                        CountryCode   = t.TryGetProperty("countryCode",  out var cc)  ? cc.GetString() ?? "PK" : "PK",
                        IsArchived    = t.TryGetProperty("isArchived",   out var ia)  && ia.GetBoolean(),
                        CreatedAt     = t.TryGetProperty("createdAt",     out var ca)  ? ca.GetDateTime() : DateTime.MinValue,
                        UserCount     = t.TryGetProperty("userCount",     out var uc)  ? uc.GetInt32()    : 0,
                        ProductCount  = t.TryGetProperty("productCount",  out var pc)  ? pc.GetInt32()    : 0,
                        OrderCount30d = t.TryGetProperty("orderCount30d", out var oc)  ? oc.GetInt32()    : 0
                    });
                }
            }
        }
        catch (Exception ex)
        {
            Toast.Show($"Error loading tenants: {ex.Message}");
        }
        _loading = false;
        StateHasChanged();
    }

    async Task ToggleArchivedFilterAsync()
    {
        _showArchived = !_showArchived;
        await LoadTenantsAsync();
    }

    async Task ArchiveAsync(TenantRow t)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm",
            $"Archive \"{t.Name}\"? This hides it from the default list but keeps all its data — you can unarchive it any time.");
        if (!confirmed) return;

        try
        {
            var res = await Http.PostAsync($"api/tenants/{t.Id}/archive", null);
            if (res.IsSuccessStatusCode)
            {
                Toast.Show($"{t.Name} archived.");
                await LoadTenantsAsync();
            }
            else
            {
                Toast.Show("Failed to archive tenant.");
            }
        }
        catch (Exception ex)
        {
            Toast.Show($"Error: {ex.Message}");
        }
    }

    async Task UnarchiveAsync(TenantRow t)
    {
        try
        {
            var res = await Http.PostAsync($"api/tenants/{t.Id}/unarchive", null);
            if (res.IsSuccessStatusCode)
            {
                Toast.Show($"{t.Name} unarchived.");
                await LoadTenantsAsync();
            }
            else
            {
                Toast.Show("Failed to unarchive tenant.");
            }
        }
        catch (Exception ex)
        {
            Toast.Show($"Error: {ex.Message}");
        }
    }

    async Task CreateTenantAsync()
    {
        if (string.IsNullOrWhiteSpace(_newName) || string.IsNullOrWhiteSpace(_newSubdomain) || string.IsNullOrWhiteSpace(_newEmail))
        {
            Toast.Show("All fields are required.");
            return;
        }

        _creating = true;
        _lastCreated = null;
        try
        {
            var payload = new { tenantName = _newName, subdomain = _newSubdomain, adminEmail = _newEmail };
            var res     = await Http.PostAsJsonAsync("api/tenants", payload);
            var content = await res.Content.ReadAsStringAsync();

            if (res.IsSuccessStatusCode)
            {
                using var doc  = JsonDocument.Parse(content);
                var data       = doc.RootElement.TryGetProperty("data", out var d) ? d : doc.RootElement;
                var tenantId   = data.TryGetProperty("tenantId", out var idEl) ? idEl.GetGuid() : (Guid?)null;
                _lastCreated   = new CreatedResult
                {
                    TenantName   = data.TryGetProperty("tenantName",   out var tn) ? tn.GetString()! : _newName,
                    AdminEmail   = data.TryGetProperty("adminEmail",   out var ae) ? ae.GetString()! : _newEmail,
                    TempPassword = data.TryGetProperty("tempPassword", out var tp) ? tp.GetString()! : "—"
                };

                // Plan is optional at creation — only assign one if the SuperAdmin
                // picked something other than "No plan yet".
                if (tenantId.HasValue && !string.IsNullOrWhiteSpace(_newPlanCode))
                {
                    try
                    {
                        var planPayload = new { planCode = _newPlanCode, billingCycle = _newCycle };
                        var planRes     = await Http.PostAsJsonAsync($"api/tenants/{tenantId}/subscription", planPayload);
                        _lastCreated.PlanAssigned = planRes.IsSuccessStatusCode;
                    }
                    catch { _lastCreated.PlanAssigned = false; }

                    if (_lastCreated.PlanAssigned == false)
                        Toast.Show("Tenant created, but plan assignment failed — assign it from the tenant's detail page.");
                }

                // Reset form and reload list
                _newName = _newSubdomain = _newEmail = string.Empty;
                _newPlanCode = string.Empty;
                _newCycle = "Monthly";
                _showCreate = false;
                await LoadTenantsAsync();
            }
            else
            {
                using var doc = JsonDocument.Parse(content);
                var msg = doc.RootElement.TryGetProperty("message", out var m) ? m.GetString() : "Creation failed.";
                Toast.Show(msg ?? "Creation failed.");
            }
        }
        catch (Exception ex)
        {
            Toast.Show($"Error: {ex.Message}");
        }
        _creating = false;
    }

    async Task OpenEditAsync(TenantRow t)
    {
        _editingId        = t.Id;
        _editName         = t.Name;
        _editSubdomain    = t.Subdomain;
        _editBillingEmail = t.BillingEmail ?? string.Empty;
        _editCountryCode  = t.CountryCode;
        _showCreate        = false; // don't show both forms at once

        _editAdminEmail = _originalAdminEmail = string.Empty;
        _loadingAdminEmail = true;
        try
        {
            var json = await Http.GetStringAsync($"api/tenants/{t.Id}/users");
            using var doc = JsonDocument.Parse(json);
            var arr = doc.RootElement.TryGetProperty("data", out var d) ? d : doc.RootElement;
            if (arr.ValueKind == JsonValueKind.Array)
            {
                foreach (var u in arr.EnumerateArray())
                {
                    if (u.TryGetProperty("role", out var r) && r.GetString() == "Admin")
                    {
                        _editAdminEmail = _originalAdminEmail = u.GetProperty("email").GetString() ?? "";
                        break;
                    }
                }
            }
        }
        catch { /* non-fatal — field just stays empty and can still be set */ }
        _loadingAdminEmail = false;
    }

    void CancelEdit() => _editingId = null;

    async Task SaveEditAsync()
    {
        if (_editingId == null) return;

        if (string.IsNullOrWhiteSpace(_editName) || string.IsNullOrWhiteSpace(_editSubdomain))
        {
            Toast.Show("Name and Subdomain are required.");
            return;
        }

        _saving = true;
        try
        {
            var payload = new
            {
                name         = _editName,
                subdomain    = _editSubdomain,
                billingEmail = _editBillingEmail,
                countryCode  = _editCountryCode
            };
            var res     = await Http.PatchAsJsonAsync($"api/tenants/{_editingId}", payload);
            var content = await res.Content.ReadAsStringAsync();

            if (res.IsSuccessStatusCode)
            {
                var emailOk = await SaveAdminEmailIfChangedAsync();

                Toast.Show(emailOk ? "Tenant updated." : "Tenant details saved, but the admin email change failed — see above.");
                _editingId = null;
                await LoadTenantsAsync();
            }
            else
            {
                using var doc = JsonDocument.Parse(content);
                var msg = doc.RootElement.TryGetProperty("message", out var m) ? m.GetString() : "Update failed.";
                Toast.Show(msg ?? "Update failed.");
            }
        }
        catch (Exception ex)
        {
            Toast.Show($"Error: {ex.Message}");
        }
        _saving = false;
    }

    /// <summary>Returns true if there was nothing to change or the change succeeded;
    /// false only when an actual attempted change failed (a toast is shown either way).</summary>
    async Task<bool> SaveAdminEmailIfChangedAsync()
    {
        var newEmail = _editAdminEmail.Trim();
        if (newEmail.Equals(_originalAdminEmail, StringComparison.OrdinalIgnoreCase))
            return true; // unchanged — nothing to do

        if (string.IsNullOrWhiteSpace(newEmail))
        {
            Toast.Show("Admin email can't be blank — left it unchanged.");
            return false;
        }

        try
        {
            var res = await Http.PatchAsJsonAsync($"api/tenants/{_editingId}/admin-email", new { email = newEmail });
            if (res.IsSuccessStatusCode) return true;

            var content = await res.Content.ReadAsStringAsync();
            using var doc = JsonDocument.Parse(content);
            var msg = doc.RootElement.TryGetProperty("message", out var m) ? m.GetString() : "Failed to update admin email.";
            Toast.Show(msg ?? "Failed to update admin email.");
            return false;
        }
        catch (Exception ex)
        {
            Toast.Show($"Error updating admin email: {ex.Message}");
            return false;
        }
    }

    // Statuses a SuperAdmin can manually assign (mirrors TenantStatus.ManuallyAssignable
    // in the API — PendingVerification and PastDue are system-assigned, not picked here).
    static readonly string[] AssignableStatuses = { "Trialing", "Active", "Suspended", "Cancelled" };

    // Changing to these blocks the tenant's access immediately, so confirm first.
    static readonly HashSet<string> BlockingStatuses = new() { "Suspended", "Cancelled" };

    async Task OnStatusSelectedAsync(TenantRow tenant, ChangeEventArgs e)
    {
        var newStatus = e.Value?.ToString();
        if (string.IsNullOrEmpty(newStatus) || newStatus == tenant.Status) return;

        if (BlockingStatuses.Contains(newStatus))
        {
            var confirmed = await JS.InvokeAsync<bool>("confirm",
                $"Set \"{tenant.Name}\" to {newStatus}? This will immediately block that tenant's access.");
            if (!confirmed)
            {
                StateHasChanged(); // re-render to snap the <select> back to the current status
                return;
            }
        }

        var previousStatus = tenant.Status;
        try
        {
            var res = await Http.PatchAsJsonAsync($"api/tenants/{tenant.Id}/status", new { status = newStatus });
            if (res.IsSuccessStatusCode)
            {
                tenant.Status = newStatus;
                Toast.Show($"{tenant.Name} set to {newStatus}.");
            }
            else
            {
                Toast.Show("Failed to update status.");
            }
        }
        catch (Exception ex)
        {
            Toast.Show($"Error: {ex.Message}");
        }
        finally
        {
            StateHasChanged();
        }
    }

    static (string Bg, string Fg) StatusColors(string status) => status switch
    {
        "Active"              => ("#d1fae5", "#065f46"),
        "Trialing"             => ("#dbeafe", "#1e40af"),
        "PastDue"              => ("#fef3c7", "#92400e"),
        "Suspended"            => ("#fee2e2", "#991b1b"),
        "Cancelled"            => ("#f3f4f6", "#374151"),
        "PendingVerification"  => ("#f3f4f6", "#374151"),
        _                      => ("#fee2e2", "#991b1b") // legacy "Inactive" and anything unrecognized
    };

    // inner models
    class TenantRow
    {
        public Guid     Id            { get; set; }
        public string   Name          { get; set; } = string.Empty;
        public string   Subdomain     { get; set; } = string.Empty;
        public string   Status        { get; set; } = string.Empty;
        public string?  BillingEmail  { get; set; }
        public string   CountryCode   { get; set; } = "PK";
        public bool     IsArchived    { get; set; }
        public DateTime CreatedAt     { get; set; }
        public int      UserCount     { get; set; }
        public int      ProductCount  { get; set; }
        public int      OrderCount30d { get; set; }
    }

    class CreatedResult
    {
        public string TenantName   { get; set; } = string.Empty;
        public string AdminEmail   { get; set; } = string.Empty;
        public string TempPassword { get; set; } = string.Empty;
        /// <summary>Null = no plan was selected at creation. True/false = whether the
        /// chosen plan was assigned successfully right after the tenant was created.</summary>
        public bool?  PlanAssigned { get; set; }
    }

    class PlanOption
    {
        public string  Code         { get; set; } = string.Empty;
        public string  Name         { get; set; } = string.Empty;
        public decimal MonthlyPrice { get; set; }
        public decimal YearlyPrice  { get; set; }
    }
}

<h2 style="margin-bottom:20px;">🏢 Tenant Management</h2>

@if (_lastCreated != null)
{
    <div style="background:#ecfdf5;border:1px solid #6ee7b7;border-radius:8px;padding:16px;margin-bottom:20px;">
        <strong style="color:#065f46;">✅ Tenant Created Successfully</strong>
        <div style="margin-top:8px;font-size:14px;color:#065f46;">
            <div><strong>Tenant:</strong> @_lastCreated.TenantName</div>
            <div><strong>Admin Email:</strong> @_lastCreated.AdminEmail</div>
            <div>
                <strong>Temp Password:</strong>
                <code style="background:#d1fae5;padding:2px 6px;border-radius:4px;font-family:monospace;font-size:13px;">@_lastCreated.TempPassword</code>
            </div>
            <div style="margin-top:6px;color:#6b7280;font-size:12px;">⚠️ Share this password securely — it won't be shown again.</div>
            @if (_lastCreated.PlanAssigned == true)
            {
                <div style="margin-top:6px;">✅ Subscription plan assigned.</div>
            }
            else if (_lastCreated.PlanAssigned == false)
            {
                <div style="margin-top:6px;color:#b91c1c;">⚠️ Plan assignment failed — assign it from the tenant's detail page.</div>
            }
        </div>
        <button class="btn" style="margin-top:10px;font-size:12px;" @onclick="() => _lastCreated = null">Dismiss</button>
    </div>
}

<!-- Toolbar -->
<div style="display:flex;gap:12px;align-items:center;margin-bottom:16px;flex-wrap:wrap;">
    <input class="input" style="width:260px;" placeholder="Search tenants..."
           @bind="_search" @bind:event="oninput" />
    <button class="btn btn-primary" @onclick="() => { _showCreate = !_showCreate; _lastCreated = null; _editingId = null; }">
        @(_showCreate ? "✕ Cancel" : "+ New Tenant")
    </button>
    <button class="btn" @onclick="LoadTenantsAsync" title="Refresh">↻ Refresh</button>
    <label style="display:flex;align-items:center;gap:6px;font-size:13px;color:#6b7280;cursor:pointer;">
        <input type="checkbox" checked="@_showArchived" @onchange="ToggleArchivedFilterAsync" />
        Show archived
    </label>
</div>

<!-- Create form -->
@if (_showCreate)
{
    <div class="card" style="margin-bottom:20px;max-width:480px;">
        <h4 style="margin-bottom:14px;">Create New Tenant</h4>
        <input class="input full" placeholder="Company / Store Name *"
               @bind="_newName" style="margin-bottom:8px;" />
        <input class="input full" placeholder="Subdomain (e.g. mystore) *"
               @bind="_newSubdomain" style="margin-bottom:8px;" />
        <input class="input full" placeholder="Admin Email *"
               type="email" @bind="_newEmail" style="margin-bottom:8px;" />

        <label style="display:block;font-size:12px;font-weight:600;color:#6b7280;margin-bottom:4px;">
            Subscription plan (optional — can be assigned later)
        </label>
        <div style="display:flex;gap:8px;margin-bottom:12px;">
            <select class="input" style="flex:1;" @bind="_newPlanCode">
                <option value="">No plan yet</option>
                @foreach (var p in _plans)
                {
                    <option value="@p.Code">@p.Name (@p.Code) — Rs @p.MonthlyPrice.ToString("N0")/mo</option>
                }
            </select>
            <select class="input" style="width:auto;" @bind="_newCycle" disabled="@string.IsNullOrEmpty(_newPlanCode)">
                <option value="Monthly">Monthly</option>
                <option value="Yearly">Yearly</option>
            </select>
        </div>

        <button class="btn btn-primary" @onclick="CreateTenantAsync" disabled="@_creating">
            @(_creating ? "Creating..." : "Create Tenant")
        </button>
    </div>
}

<!-- Edit form -->
@if (_editingId != null)
{
    <div class="card" style="margin-bottom:20px;max-width:480px;">
        <h4 style="margin-bottom:14px;">Edit Tenant</h4>
        <input class="input full" placeholder="Company / Store Name *"
               @bind="_editName" style="margin-bottom:8px;" />
        <input class="input full" placeholder="Subdomain *"
               @bind="_editSubdomain" style="margin-bottom:8px;" />
        <input class="input full" placeholder="Billing Email"
               type="email" @bind="_editBillingEmail" style="margin-bottom:8px;" />
        <input class="input full" placeholder="Country Code (e.g. PK)"
               @bind="_editCountryCode" style="margin-bottom:8px;" maxlength="2" />

        <label style="display:block;font-size:12px;font-weight:600;color:#6b7280;margin-bottom:4px;">
            Admin login email @(_loadingAdminEmail ? "(loading...)" : "")
        </label>
        <input class="input full" placeholder="Admin Email *"
               type="email" @bind="_editAdminEmail" disabled="@_loadingAdminEmail" style="margin-bottom:4px;" />
        <p style="font-size:11px;color:#9ca3af;margin:0 0 12px;">
            This is the tenant's own login, not the billing email above. Changing it resets
            email verification for that account.
        </p>

        <div style="display:flex;gap:8px;">
            <button class="btn btn-primary" @onclick="SaveEditAsync" disabled="@_saving">
                @(_saving ? "Saving..." : "Save Changes")
            </button>
            <button class="btn" @onclick="CancelEdit" disabled="@_saving">Cancel</button>
        </div>
    </div>
}

<!-- Tenant list -->
@if (_loading)
{
    <div class="spinner"></div>
}
else if (!Filtered.Any())
{
    <div class="card">
        <p style="color:#9ca3af;">No tenants found.</p>
    </div>
}
else
{
    <div class="card" style="padding:0;overflow:hidden;">
        <table class="table" style="margin:0;">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Subdomain</th>
                    <th>Users</th>
                    <th>Products</th>
                    <th>Orders (30d)</th>
                    <th>Created</th>
                    <th>Status</th>
                    <th></th>
                    <th></th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var t in Filtered)
                {
                    var (bg, fg) = StatusColors(t.Status);
                    <tr style="@(t.IsArchived ? "opacity:.55;" : "")">
                        <td>
                            <a href="@($"/admin/tenants/{t.Id}")"><strong>@t.Name</strong></a>
                            @if (t.IsArchived)
                            {
                                <span style="margin-left:6px;padding:1px 8px;border-radius:10px;font-size:11px;font-weight:600;background:#f3f4f6;color:#6b7280;">Archived</span>
                            }
                        </td>
                        <td style="color:#6b7280;font-family:monospace;">@t.Subdomain</td>
                        <td>@t.UserCount</td>
                        <td>@t.ProductCount</td>
                        <td>@t.OrderCount30d</td>
                        <td style="color:#6b7280;font-size:13px;">@t.CreatedAt.ToString("yyyy-MM-dd")</td>
                        <td>
                            <span style="padding:2px 10px;border-radius:12px;font-size:12px;font-weight:600;
                                         background:@bg;color:@fg;">
                                @t.Status
                            </span>
                        </td>
                        <td>
                            <select class="input" style="padding:3px 8px;font-size:12px;width:auto;"
                                    value="@t.Status"
                                    @onchange="e => OnStatusSelectedAsync(t, e)">
                                @if (!AssignableStatuses.Contains(t.Status))
                                {
                                    <option value="@t.Status">@t.Status (system-assigned)</option>
                                }
                                @foreach (var s in AssignableStatuses)
                                {
                                    <option value="@s">@s</option>
                                }
                            </select>
                        </td>
                        <td>
                            <button class="btn" style="padding:3px 10px;font-size:12px;" @onclick="() => OpenEditAsync(t)">Edit</button>
                        </td>
                        <td>
                            @if (t.IsArchived)
                            {
                                <button class="btn" style="padding:3px 10px;font-size:12px;color:#065f46;" @onclick="() => UnarchiveAsync(t)">Unarchive</button>
                            }
                            else
                            {
                                <button class="btn" style="padding:3px 10px;font-size:12px;color:#b91c1c;" @onclick="() => ArchiveAsync(t)">Archive</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <p style="margin-top:10px;color:#9ca3af;font-size:13px;">@Filtered.Count() tenant(s) total</p>
}
