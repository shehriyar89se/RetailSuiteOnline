@page "/admin/plans"
@layout MainLayout
@inject HttpClient Http
@inject AuthService AuthSvc
@inject NavigationManager Nav
@inject ToastService Toast
@using System.Text.Json

@code {
    bool _loading = true;
    List<PlanRow> _plans = new();

    protected override void OnInitialized()
    {
        // Guard: only super admin may view this page
        if (!AuthSvc.IsSuperAdmin)
        {
            Nav.NavigateTo("/", replace: true);
            return;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await LoadPlansAsync();
    }

    async Task LoadPlansAsync()
    {
        _loading = true;
        try
        {
            var json = await Http.GetStringAsync("api/subscriptions/plans");
            using var doc = JsonDocument.Parse(json);
            var arr = doc.RootElement.TryGetProperty("data", out var d) ? d : doc.RootElement;

            _plans.Clear();
            if (arr.ValueKind == JsonValueKind.Array)
            {
                foreach (var p in arr.EnumerateArray())
                {
                    _plans.Add(new PlanRow
                    {
                        Id           = p.GetProperty("id").GetGuid(),
                        Code         = p.GetProperty("code").GetString() ?? "",
                        Name         = p.GetProperty("name").GetString() ?? "",
                        Description  = p.TryGetProperty("description", out var desc) ? desc.GetString() ?? "" : "",
                        MonthlyPrice = p.GetProperty("monthlyPrice").GetDecimal(),
                        YearlyPrice  = p.GetProperty("yearlyPrice").GetDecimal(),
                        Currency     = p.TryGetProperty("currency",  out var cur) ? cur.GetString() ?? "PKR" : "PKR",
                        TrialDays    = p.TryGetProperty("trialDays", out var td)  ? td.GetInt32() : 0,
                        IsActive     = p.TryGetProperty("isActive",  out var ia)  && ia.GetBoolean()
                    });
                }
            }
        }
        catch (Exception ex)
        {
            Toast.Show($"Error loading plans: {ex.Message}");
        }
        _loading = false;
        StateHasChanged();
    }

    async Task SavePriceAsync(PlanRow plan)
    {
        if (plan.MonthlyPrice < 0 || plan.YearlyPrice < 0)
        {
            Toast.Show("Price cannot be negative.");
            return;
        }

        plan.Saving = true;
        try
        {
            var payload = new { monthlyPrice = plan.MonthlyPrice, yearlyPrice = plan.YearlyPrice };
            var res     = await Http.PatchAsJsonAsync($"api/subscriptions/plans/{plan.Id}", payload);

            if (res.IsSuccessStatusCode)
            {
                Toast.Show($"{plan.Name} pricing updated.");
            }
            else
            {
                var content = await res.Content.ReadAsStringAsync();
                using var doc = JsonDocument.Parse(content);
                var msg = doc.RootElement.TryGetProperty("message", out var m) ? m.GetString() : "Failed to update pricing.";
                Toast.Show(msg ?? "Failed to update pricing.");
            }
        }
        catch (Exception ex)
        {
            Toast.Show($"Error: {ex.Message}");
        }
        plan.Saving = false;
    }

    class PlanRow
    {
        public Guid    Id           { get; set; }
        public string  Code         { get; set; } = string.Empty;
        public string  Name         { get; set; } = string.Empty;
        public string  Description  { get; set; } = string.Empty;
        public decimal MonthlyPrice { get; set; }
        public decimal YearlyPrice  { get; set; }
        public string  Currency     { get; set; } = "PKR";
        public int     TrialDays    { get; set; }
        public bool    IsActive     { get; set; }
        public bool    Saving       { get; set; }
    }
}

<h2 style="margin-bottom:6px;">💳 Subscription Plans</h2>
<p style="color:#6b7280;font-size:13px;margin-bottom:20px;">
    Change what each plan charges. Updates apply to future billing cycles and any new tenant
    assigned this plan — a tenant already mid-cycle isn't retroactively re-billed until its
    next renewal.
</p>

@if (_loading)
{
    <div class="spinner"></div>
}
else
{
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:16px;">
        @foreach (var plan in _plans)
        {
            <div class="card">
                <div style="display:flex;justify-content:space-between;align-items:start;margin-bottom:4px;">
                    <h4 style="margin:0;">@plan.Name</h4>
                    <span style="font-size:11px;color:#9ca3af;font-family:monospace;">@plan.Code</span>
                </div>
                @if (!plan.IsActive)
                {
                    <span style="display:inline-block;margin-bottom:8px;padding:1px 8px;border-radius:10px;font-size:11px;font-weight:600;background:#f3f4f6;color:#6b7280;">Inactive</span>
                }
                @if (!string.IsNullOrWhiteSpace(plan.Description))
                {
                    <p style="color:#6b7280;font-size:12px;margin:0 0 12px;">@plan.Description</p>
                }

                <label style="display:block;font-size:12px;font-weight:600;color:#6b7280;margin-bottom:4px;">
                    Monthly price (@plan.Currency)
                </label>
                <input class="input full" type="number" min="0" step="0.01"
                       @bind="plan.MonthlyPrice" style="margin-bottom:10px;" />

                <label style="display:block;font-size:12px;font-weight:600;color:#6b7280;margin-bottom:4px;">
                    Yearly price (@plan.Currency)
                </label>
                <input class="input full" type="number" min="0" step="0.01"
                       @bind="plan.YearlyPrice" style="margin-bottom:12px;" />

                <p style="font-size:11px;color:#9ca3af;margin:0 0 12px;">
                    @plan.TrialDays day trial
                </p>

                <button class="btn btn-primary" style="width:100%;" disabled="@plan.Saving" @onclick="() => SavePriceAsync(plan)">
                    @(plan.Saving ? "Saving..." : "Save Pricing")
                </button>
            </div>
        }
    </div>
}
