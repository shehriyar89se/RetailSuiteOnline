@page "/store/{TenantSlug}"
@layout CustomerLayout
@inherits StorefrontPageBase
@inject HttpClient Http
@inject NavigationManager Nav
@inject ToastService Toast
@inject ApiUrlService Api
@inject IJSRuntime JS
@implements IDisposable
@using System.Text.Json

<section class="shop-hero">
    <div>
        <p class="shop-eyebrow">Fresh arrivals, just for you</p>
        <h1>@(_selectedCategoryName ?? "Find your next favorite")</h1>
        <p>Quality picks at great prices — browse, compare, and checkout in just a few taps.</p>
    </div>
    <div class="shop-hero-search">
        <input class="input shop-search-input" placeholder="Search by product, SKU, or brand"
               value="@_search"
               @oninput="OnSearchChanged" />
    </div>
</section>

@if (_categoryRows.Any())
{
    <!-- Section 1: a handful of curated rows, one per category, so the
         home page shows a taste of everything instead of one flat list.
         Only the first few rows show by default; "Explore all categories"
         reveals the rest. Row picks are just "a few per category" for now —
         a natural place to swap in per-customer picks (recent searches /
         browsing interest) once that history is tracked somewhere. -->
    <section class="category-rows-section">
        <div class="section-head">
            <h2>Shop by category</h2>
        </div>
        @foreach (var row in VisibleCategoryRows)
        {
            <div class="category-row">
                <div class="category-row-head">
                    <h3>@row.Category.Name</h3>
                    <button type="button" class="category-row-view-all" @onclick="() => ViewAllInCategory(row.Category.Id)">View all →</button>
                </div>
                <div class="category-row-scroll">
                    @foreach (var p in row.Products)
                    {
                        <div class="row-card" @onclick="() => GoToProduct(p.Id)">
                            @if (!string.IsNullOrEmpty(p.ImageUrl))
                            {
                                <img src="@Api.Absolute(p.ImageUrl)" alt="@p.Name" class="row-card-img" />
                            }
                            else
                            {
                                <div class="row-card-img product-img-placeholder">No image</div>
                            }
                            <div class="row-card-name">@p.Name</div>
                            <div class="row-card-price">
                                @if (p.MinPrice > 0)
                                {
                                    <span>Rs @p.MinPrice.ToString("N2")</span>
                                }
                                else
                                {
                                    <span style="color:#9ca3af;">Price varies</span>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
        @if (HasMoreCategoryRows)
        {
            <button type="button" class="btn explore-categories-btn" @onclick="() => _showAllCategoryRows = true">
                Explore all categories
            </button>
        }
    </section>
}

<section id="all-products" class="all-products-section">
<div class="section-head">
    <h2>All products</h2>
</div>
<div class="category-strip" aria-label="Product categories">
    <button type="button"
            class="category-chip @(_selectedCategoryId == null ? "selected" : "")"
            @onclick="() => SelectCategory(null)">
        All
    </button>
    @if (_tree != null)
    {
        @foreach (var row in FlattenVisibleTree())
        {
            var c = row.Node;
            <button type="button"
                    class="category-chip @(_selectedCategoryId == c.Id ? "selected" : "")"
                    @onclick="() => SelectCategory(c.Id)">
                @c.Name
                <span>@c.TotalCount</span>
            </button>
        }
    }
</div>

<!-- Filter/view toolbar. "Filter" toggles the sidebar's visibility on
     mobile (it's always visible on desktop, where this button is hidden
     via CSS); the grid/list toggle switches the product layout on any
     screen size. -->
<div class="shop-toolbar">
    <button type="button" class="toolbar-filter-btn" @onclick="() => _mobileFiltersOpen = !_mobileFiltersOpen">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="4,4 20,4 14,12 14,19 10,21 10,12" /></svg>
        Filter
    </button>
    <select class="input toolbar-sort" value="@_sort" @onchange="OnSortChanged">
        <option value="name">Sort: Name (A-Z)</option>
        <option value="newest">Newest first</option>
        <option value="price_asc">Price: low to high</option>
        <option value="price_desc">Price: high to low</option>
    </select>
    <div class="view-toggle">
        <button type="button" class="@(_viewMode == "list" ? "active" : "")" aria-label="List view" @onclick='() => _viewMode = "list"'>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="8" y1="6" x2="21" y2="6" /><line x1="8" y1="12" x2="21" y2="12" /><line x1="8" y1="18" x2="21" y2="18" /><circle cx="4" cy="6" r="1.2" fill="currentColor" stroke="none" /><circle cx="4" cy="12" r="1.2" fill="currentColor" stroke="none" /><circle cx="4" cy="18" r="1.2" fill="currentColor" stroke="none" /></svg>
        </button>
        <button type="button" class="@(_viewMode == "grid" ? "active" : "")" aria-label="Grid view" @onclick='() => _viewMode = "grid"'>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1" /><rect x="14" y="3" width="7" height="7" rx="1" /><rect x="3" y="14" width="7" height="7" rx="1" /><rect x="14" y="14" width="7" height="7" rx="1" /></svg>
        </button>
    </div>
</div>

<div class="shop-home-layout">

    <!-- Categories sidebar -->
    <aside class="shop-sidebar @(_mobileFiltersOpen ? "open" : "")">
        <div class="shop-filter-title">
            <h4>Filters</h4>
            @if (_selectedBrandIds.Any() || _selectedAttrValueIds.Any()
                 || _priceMin.HasValue || _priceMax.HasValue)
            {
                <button type="button" class="link-button" @onclick="ClearFilters">Reset</button>
            }
        </div>

        <div class="cat-row @(_selectedCategoryId == null ? "selected" : "")"
             @onclick="() => SelectCategory(null)">
            <span class="cat-twisty"></span>
            <strong>All products</strong>
        </div>

        @if (_tree != null)
        {
            @foreach (var row in FlattenVisibleTree())
            {
                var c     = row.Node;
                var depth = row.Depth;
                var open  = _openCats.Contains(c.Id);
                <div class="cat-row @(_selectedCategoryId == c.Id ? "selected" : "")"
                     style="padding-left:@(8 + depth * 14)px;"
                     @onclick="() => SelectCategory(c.Id)">
                    @if (c.Children.Any())
                    {
                        <span class="cat-twisty" @onclick:stopPropagation="true"
                              @onclick="() => ToggleCat(c.Id)">@(open ? "▾" : "▸")</span>
                    }
                    else
                    {
                        <span class="cat-twisty"></span>
                    }
                    <span style="flex:1;">@c.Name</span>
                    <span style="color:#9ca3af;font-size:12px;">(@c.TotalCount)</span>
                </div>
            }
        }
        @if (_filters != null && (_filters.Brands.Any() || _filters.Attributes.Any()))
        {
            <hr style="border:none;border-top:1px solid #e5e7eb;margin:14px 0;" />

            @if (_filters.Brands.Any())
            {
                <h5 class="facet-title">Brand</h5>
                @foreach (var b in _filters.Brands)
                {
                    var picked = _selectedBrandIds.Contains(b.Id);
                    <label class="facet-line">
                        <input type="checkbox" checked="@picked"
                               @onchange="e => ToggleBrand(b.Id, (bool)(e.Value ?? false))" />
                        <span style="flex:1;">@b.Name</span>
                        <span style="color:#9ca3af;font-size:12px;">@b.Count</span>
                    </label>
                }
            }

            @foreach (var attr in _filters.Attributes)
            {
                <h5 class="facet-title">@attr.Name</h5>
                @foreach (var v in attr.Values)
                {
                    var picked = _selectedAttrValueIds.Contains(v.Id);
                    <label class="facet-line">
                        <input type="checkbox" checked="@picked"
                               @onchange="e => ToggleAttr(v.Id, (bool)(e.Value ?? false))" />
                        <span style="flex:1;">@v.Value</span>
                        <span style="color:#9ca3af;font-size:12px;">@v.Count</span>
                    </label>
                }
            }

            @if (_filters.PriceMax > 0)
            {
                <h5 class="facet-title">Price (Rs)</h5>
                <div class="price-filter-row">
                    <input type="number" class="input"
                           placeholder="@_filters.PriceMin.ToString("0")"
                           @bind="_priceMin" @bind:event="onchange" />
                    <span>to</span>
                    <input type="number" class="input"
                           placeholder="@_filters.PriceMax.ToString("0")"
                           @bind="_priceMax" @bind:event="onchange" />
                </div>
                <button class="btn filter-apply"
                        @onclick="ApplyPriceFilter">Apply</button>
            }

            @if (_selectedBrandIds.Any() || _selectedAttrValueIds.Any()
                 || _priceMin.HasValue || _priceMax.HasValue)
            {
                <button class="btn filter-clear"
                        @onclick="ClearFilters">Clear filters</button>
            }
        }

        <div class="shop-sidebar-utility">
            <a class="btn full" href="@($"/store/{TenantSlug}/track")">Track an order</a>
        </div>
    </aside>

    <!-- Product grid -->
    <section class="shop-product-section">
        <div class="shop-grid-header">
            <div>
                <h2>@(_selectedCategoryName ?? "All products")</h2>
                <p>@_products.Count item@(_products.Count == 1 ? "" : "s") available</p>
            </div>
        </div>

        @if (_loading)
        {
            <div class="product-grid">
                @for (var i = 0; i < 8; i++)
                {
                    <div class="skeleton-card">
                        <div class="skeleton-img skeleton-shimmer"></div>
                        <div class="skeleton-line skeleton-shimmer"></div>
                        <div class="skeleton-line skeleton-shimmer short"></div>
                        <div class="skeleton-btn skeleton-shimmer"></div>
                    </div>
                }
            </div>
        }
        else if (!_products.Any())
        {
            <p style="color:#9ca3af;">No products found.</p>
        }
        else if (_viewMode == "list")
        {
            <div class="product-list">
                @foreach (var p in _products)
                {
                    <div class="product-list-item" @onclick="() => GoToProduct(p.Id)">
                        @if (!string.IsNullOrEmpty(p.ImageUrl))
                        {
                            <img src="@Api.Absolute(p.ImageUrl)" alt="@p.Name" class="product-list-img" />
                        }
                        else
                        {
                            <div class="product-list-img product-img-placeholder">No image</div>
                        }
                        <div class="product-list-info">
                            @if (!string.IsNullOrEmpty(p.BrandName))
                            {
                                <div class="product-brand">@p.BrandName</div>
                            }
                            <div class="product-name">@p.Name</div>
                            <div class="product-stock @(p.DefaultVariantStock <= 0 ? "out" : p.DefaultVariantStock <= 5 ? "low" : "")">
                                @(p.DefaultVariantStock <= 0 ? "Out of stock" : $"{p.DefaultVariantStock} in stock")
                            </div>
                        </div>
                        <div class="product-list-price">
                            @if (p.MinPrice > 0)
                            {
                                <span>Rs @p.MinPrice.ToString("N2")</span>
                            }
                            else
                            {
                                <span style="color:#9ca3af;">Price varies</span>
                            }
                        </div>
                        <div class="product-list-actions">
                            @if (p.DefaultVariantId.HasValue)
                            {
                                <button class="btn btn-primary"
                                        disabled="@(p.DefaultVariantStock <= 0)"
                                        @onclick:stopPropagation="true"
                                        @onclick="() => AddToCart(p)">
                                    @(p.DefaultVariantStock <= 0 ? "Unavailable" : "Add to cart")
                                </button>
                            }
                            else
                            {
                                <button class="btn" @onclick:stopPropagation="true"
                                        @onclick="() => GoToProduct(p.Id)">
                                    View options
                                </button>
                            }
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="product-grid">
                @foreach (var p in _products)
                {
                    <div class="product-card" @onclick="() => GoToProduct(p.Id)">
                        @if (!string.IsNullOrEmpty(p.ImageUrl))
                        {
                            <img src="@Api.Absolute(p.ImageUrl)" alt="@p.Name" class="product-img" />
                        }
                        else
                        {
                            <div class="product-img-placeholder">No image</div>
                        }
                        <div class="product-info">
                            @if (!string.IsNullOrEmpty(p.BrandName))
                            {
                                <div class="product-brand">@p.BrandName</div>
                            }
                            <div class="product-name">@p.Name</div>
                            @if (!string.IsNullOrEmpty(p.ShortDescription))
                            {
                                <div class="product-desc">@p.ShortDescription</div>
                            }
                            <div class="product-price">
                                @if (p.MinPrice > 0)
                                {
                                    <span>Rs @p.MinPrice.ToString("N2")</span>
                                }
                                else
                                {
                                    <span style="color:#9ca3af;">Price varies</span>
                                }
                            </div>
                            <div class="product-stock @(p.DefaultVariantStock <= 0 ? "out" : p.DefaultVariantStock <= 5 ? "low" : "")">
                                @(p.DefaultVariantStock <= 0 ? "Out of stock" : $"{p.DefaultVariantStock} in stock")
                            </div>
                            <div class="product-actions">
                                @if (p.DefaultVariantId.HasValue)
                                {
                                    <button class="btn btn-primary"
                                            disabled="@(p.DefaultVariantStock <= 0)"
                                            @onclick:stopPropagation="true"
                                            @onclick="() => AddToCart(p)">
                                        @(p.DefaultVariantStock <= 0 ? "Unavailable" : "Add to cart")
                                    </button>
                                }
                                else
                                {
                                    <button class="btn" @onclick:stopPropagation="true"
                                            @onclick="() => GoToProduct(p.Id)">
                                        View options
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </section>
</div>
</section>

@code {
    bool _loading = true;
    string _viewMode = "grid";
    bool _mobileFiltersOpen;
    string _sort = "name";
    string _search = string.Empty;
    Guid? _selectedCategoryId;
    string? _selectedCategoryName;
    List<CategoryNode>? _tree;
    HashSet<Guid> _openCats = new();
    List<ProductRow> _products = new();

    // Section 1 — a few rows of products grouped by category. Only the first
    // few show; "Explore all categories" reveals the rest.
    const int InitialCategoryRowCount = 3;
    const int CategoryRowProductCount = 8;
    List<CategoryRow> _categoryRows = new();
    bool _showAllCategoryRows;

    IEnumerable<CategoryRow> VisibleCategoryRows =>
        _showAllCategoryRows ? _categoryRows : _categoryRows.Take(InitialCategoryRowCount);
    bool HasMoreCategoryRows => _categoryRows.Count > InitialCategoryRowCount;

    // Faceted filter state
    Filters? _filters;
    HashSet<Guid> _selectedBrandIds     = new();
    HashSet<Guid> _selectedAttrValueIds = new();
    decimal? _priceMin;
    decimal? _priceMax;

    // Debounce timer for search-as-you-type.
    System.Timers.Timer? _searchTimer;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await LoadCategories();
        await LoadFilters();
        await LoadProducts();
        await LoadCategoryRows();
    }

    async Task LoadFilters()
    {
        try
        {
            var url = ShopApi("filters");
            if (_selectedCategoryId.HasValue) url += $"?categoryId={_selectedCategoryId}";
            var json = await Http.GetStringAsync(url);
            using var doc = JsonDocument.Parse(json);
            var d = doc.RootElement.GetProperty("data");

            _filters = new Filters();
            foreach (var b in d.GetProperty("brands").EnumerateArray())
            {
                _filters.Brands.Add(new BrandFacet
                {
                    Id    = b.GetProperty("id").GetGuid(),
                    Name  = b.GetProperty("name").GetString() ?? "",
                    Count = b.GetProperty("count").GetInt32()
                });
            }
            foreach (var a in d.GetProperty("attributes").EnumerateArray())
            {
                var af = new AttrFacet { Name = a.GetProperty("name").GetString() ?? "" };
                foreach (var v in a.GetProperty("values").EnumerateArray())
                {
                    af.Values.Add(new AttrValueFacet
                    {
                        Id    = v.GetProperty("id").GetGuid(),
                        Value = v.GetProperty("value").GetString() ?? "",
                        Count = v.GetProperty("count").GetInt32()
                    });
                }
                _filters.Attributes.Add(af);
            }
            var price = d.GetProperty("price");
            _filters.PriceMin = price.GetProperty("min").GetDecimal();
            _filters.PriceMax = price.GetProperty("max").GetDecimal();
            StateHasChanged();
        }
        catch { /* non-fatal */ }
    }

    void ToggleBrand(Guid id, bool on)
    {
        if (on) _selectedBrandIds.Add(id);
        else    _selectedBrandIds.Remove(id);
        _ = LoadProducts();
    }
    void ToggleAttr(Guid id, bool on)
    {
        if (on) _selectedAttrValueIds.Add(id);
        else    _selectedAttrValueIds.Remove(id);
        _ = LoadProducts();
    }
    void ApplyPriceFilter() => _ = LoadProducts();
    void OnSortChanged(ChangeEventArgs e)
    {
        _sort = e.Value?.ToString() ?? "name";
        _ = LoadProducts();
    }
    void ClearFilters()
    {
        _selectedBrandIds.Clear();
        _selectedAttrValueIds.Clear();
        _priceMin = _priceMax = null;
        _ = LoadProducts();
    }

    async Task LoadCategories()
    {
        try
        {
            var json = await Http.GetStringAsync(ShopApi("categories"));
            using var doc = JsonDocument.Parse(json);
            var data = doc.RootElement.GetProperty("data");

            // New shape: { Flat: [...], Tree: [...] }. Read Tree.
            if (data.TryGetProperty("tree", out var treeEl))
            {
                _tree = ParseTree(treeEl);
                // Expand top-level only — leave deeper levels collapsed.
                _openCats.Clear();
                if (_tree != null)
                    foreach (var n in _tree) _openCats.Add(n.Id);
            }
            StateHasChanged();
        }
        catch { /* non-fatal */ }
    }

    List<CategoryNode> ParseTree(JsonElement el)
    {
        var list = new List<CategoryNode>();
        if (el.ValueKind != JsonValueKind.Array) return list;
        foreach (var e in el.EnumerateArray())
        {
            var n = new CategoryNode
            {
                Id           = e.GetProperty("id").GetGuid(),
                Name         = e.GetProperty("name").GetString() ?? "",
                Slug         = e.TryGetProperty("slug", out var sl) ? sl.GetString() ?? "" : "",
                ProductCount = e.TryGetProperty("productCount", out var pc) ? pc.GetInt32() : 0,
                TotalCount   = e.TryGetProperty("productCountWithChildren", out var tc) ? tc.GetInt32() : 0
            };
            if (e.TryGetProperty("children", out var kids))
                n.Children = ParseTree(kids);
            list.Add(n);
        }
        return list;
    }

    void ToggleCat(Guid id)
    {
        if (_openCats.Contains(id)) _openCats.Remove(id);
        else _openCats.Add(id);
    }

    IEnumerable<(CategoryNode Node, int Depth)> FlattenVisibleTree()
    {
        if (_tree == null) yield break;
        foreach (var r in WalkVisible(_tree, 0)) yield return r;
    }
    IEnumerable<(CategoryNode, int)> WalkVisible(IEnumerable<CategoryNode> nodes, int depth)
    {
        foreach (var n in nodes)
        {
            yield return (n, depth);
            if (_openCats.Contains(n.Id))
                foreach (var c in WalkVisible(n.Children, depth + 1)) yield return c;
        }
    }

    async Task LoadProducts()
    {
        _loading = true;
        StateHasChanged();

        var url = ShopApi($"products?page=1&pageSize=60&sort={_sort}");
        if (_selectedCategoryId.HasValue) url += $"&categoryId={_selectedCategoryId}";
        if (!string.IsNullOrWhiteSpace(_search)) url += $"&search={Uri.EscapeDataString(_search)}";
        if (_selectedBrandIds.Any())
            url += $"&brandIds={string.Join(",", _selectedBrandIds)}";
        if (_selectedAttrValueIds.Any())
            url += $"&attrValueIds={string.Join(",", _selectedAttrValueIds)}";
        if (_priceMin.HasValue) url += $"&priceMin={_priceMin.Value}";
        if (_priceMax.HasValue) url += $"&priceMax={_priceMax.Value}";

        _products = await FetchProductsAsync(url, notifyOnError: true);

        _loading = false;
        StateHasChanged();
    }

    // Section 1's rows use the same product shape/endpoint as the main grid,
    // just scoped to one category at a time and capped to a handful of items.
    async Task LoadCategoryRows()
    {
        if (_tree == null) return;

        // Only top-level categories get their own row — Section 1 is meant as a
        // quick taste of the catalog, not a full replay of the sidebar's nested tree.
        var eligible = _tree.Where(c => c.TotalCount > 0).ToList();
        var tasks = eligible.Select(async c =>
        {
            var url = ShopApi($"products?page=1&pageSize={CategoryRowProductCount}&categoryId={c.Id}&sort=newest");
            var products = await FetchProductsAsync(url);
            return new CategoryRow { Category = c, Products = products };
        });

        var rows = await Task.WhenAll(tasks);
        _categoryRows = rows.Where(r => r.Products.Count > 0).ToList();
        StateHasChanged();
    }

    async Task<List<ProductRow>> FetchProductsAsync(string url, bool notifyOnError = false)
    {
        var result = new List<ProductRow>();
        try
        {
            var json = await Http.GetStringAsync(url);
            using var doc = JsonDocument.Parse(json);
            if (doc.RootElement.TryGetProperty("data", out var d)
                && d.TryGetProperty("items", out var items)
                && items.ValueKind == JsonValueKind.Array)
            {
                foreach (var p in items.EnumerateArray())
                {
                    var row = new ProductRow
                    {
                        Id               = p.GetProperty("id").GetGuid(),
                        Name             = p.GetProperty("name").GetString() ?? "",
                        ShortDescription = p.TryGetProperty("shortDescription", out var sd) && sd.ValueKind == JsonValueKind.String ? sd.GetString() : null,
                        BrandName        = p.TryGetProperty("brandName",        out var bn) && bn.ValueKind == JsonValueKind.String ? bn.GetString() : null,
                        ImageUrl         = p.TryGetProperty("imageUrl",         out var img) ? img.GetString() : null,
                        MinPrice         = p.TryGetProperty("minPrice",         out var mp) ? mp.GetDecimal() : 0m
                    };

                    if (p.TryGetProperty("defaultVariant", out var dv) && dv.ValueKind == JsonValueKind.Object)
                    {
                        row.DefaultVariantId    = dv.GetProperty("id").GetGuid();
                        row.DefaultVariantSku   = dv.TryGetProperty("sku", out var sku) ? sku.GetString() ?? "" : "";
                        row.DefaultVariantStock = dv.TryGetProperty("stockQuantity", out var sq) ? sq.GetInt32() : 0;
                    }

                    result.Add(row);
                }
            }
        }
        catch (Exception ex) { if (notifyOnError) Toast.Show($"Failed to load: {ex.Message}"); }
        return result;
    }

    async Task ViewAllInCategory(Guid id)
    {
        await SelectCategory(id);
        await JS.InvokeVoidAsync("scrollToId", "all-products");
    }

    async Task SelectCategory(Guid? id)
    {
        _selectedCategoryId   = id;
        _selectedCategoryName = id == null ? null : FindNode(_tree, id.Value)?.Name;
        // Clear faceted selections when switching scope — facet ids would otherwise be stale.
        _selectedBrandIds.Clear();
        _selectedAttrValueIds.Clear();
        _priceMin = _priceMax = null;
        await LoadFilters();
        await LoadProducts();
    }

    static CategoryNode? FindNode(IEnumerable<CategoryNode>? nodes, Guid id)
    {
        if (nodes == null) return null;
        foreach (var n in nodes)
        {
            if (n.Id == id) return n;
            var hit = FindNode(n.Children, id);
            if (hit != null) return hit;
        }
        return null;
    }

    void OnSearchChanged(ChangeEventArgs e)
    {
        _search = e.Value?.ToString() ?? string.Empty;
        _searchTimer?.Dispose();
        _searchTimer = new System.Timers.Timer(300);
        _searchTimer.Elapsed += async (_, _) =>
        {
            _searchTimer?.Dispose();
            _searchTimer = null;
            await InvokeAsync(LoadProducts);
        };
        _searchTimer.AutoReset = false;
        _searchTimer.Start();
    }

    /// <summary>A search typed just before navigating away leaves a live timer whose
    /// callback captures this component — disposing here keeps it from holding the
    /// component (and its scoped services) alive after the circuit moves on.</summary>
    public void Dispose() => _searchTimer?.Dispose();

    void GoToProduct(Guid id) => Nav.NavigateTo($"/store/{TenantSlug}/product/{id}");

    void AddToCart(ProductRow p)
    {
        if (!p.DefaultVariantId.HasValue || p.DefaultVariantStock <= 0) return;

        Cart.AddItem(new CartItem
        {
            VariantId   = p.DefaultVariantId.Value,
            ProductId   = p.Id,
            ProductName = p.Name,
            SKU         = p.DefaultVariantSku,
            ImageUrl    = p.ImageUrl,
            UnitPrice   = p.MinPrice,
            Quantity    = 1
        });
        Toast.Show($"{p.Name} added to cart.");
    }

    public class CategoryNode
    {
        public Guid    Id           { get; set; }
        public string  Name         { get; set; } = "";
        public string  Slug         { get; set; } = "";
        public int     ProductCount { get; set; }
        /// <summary>Aggregated count including descendants — what the sidebar displays.</summary>
        public int     TotalCount   { get; set; }
        public List<CategoryNode> Children { get; set; } = new();
    }

    class CategoryRow
    {
        public CategoryNode   Category { get; set; } = default!;
        public List<ProductRow> Products { get; set; } = new();
    }

    class ProductRow
    {
        public Guid    Id               { get; set; }
        public string  Name             { get; set; } = "";
        public string? ShortDescription { get; set; }
        public string? BrandName        { get; set; }
        public string? ImageUrl         { get; set; }
        public decimal MinPrice         { get; set; }

        /// <summary>Cheapest active variant — lets the grid card add-to-cart directly.
        /// Null only if the product somehow has zero active variants.</summary>
        public Guid?   DefaultVariantId    { get; set; }
        public string  DefaultVariantSku   { get; set; } = "";
        public int     DefaultVariantStock { get; set; }
    }

    class Filters
    {
        public List<BrandFacet> Brands     { get; set; } = new();
        public List<AttrFacet>  Attributes { get; set; } = new();
        public decimal PriceMin            { get; set; }
        public decimal PriceMax            { get; set; }
    }
    class BrandFacet     { public Guid   Id { get; set; } public string Name  { get; set; } = ""; public int Count { get; set; } }
    class AttrFacet      { public string Name { get; set; } = ""; public List<AttrValueFacet> Values { get; set; } = new(); }
    class AttrValueFacet { public Guid   Id { get; set; } public string Value { get; set; } = ""; public int Count { get; set; } }
}
