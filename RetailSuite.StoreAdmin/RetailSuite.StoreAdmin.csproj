<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Workstation GC instead of the multi-core default. Server GC keeps a heap
         per CPU core and is slow to hand memory back, which is wasteful when
         several apps share one App Service plan at low traffic. Revisit if
         sustained concurrent load ever makes throughput matter more than RAM. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RetailSuite.Shared\RetailSuite.Shared.csproj" />
  </ItemGroup>

</Project>
