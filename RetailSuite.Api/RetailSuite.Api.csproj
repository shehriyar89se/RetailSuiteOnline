
<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Swagger reads these XML files for endpoint summaries / param docs. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Suppress 1591 ("missing XML on public member") so undocumented endpoints don't fail the build. -->
    <NoWarn>$(NoWarn);1591</NoWarn>
    <!-- Workstation GC instead of the multi-core default. Server GC keeps a heap
         per CPU core and is slow to hand memory back, which is wasteful when
         several apps share one App Service plan at low traffic. Revisit if
         sustained concurrent load ever makes throughput matter more than RAM. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RetailSuite.Infrastructure\RetailSuite.Infrastructure.csproj" />
    <ProjectReference Include="..\RetailSuite.Shared\RetailSuite.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Diagnostics.HealthChecks" Version="2.2.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.0">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="8.0.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.5.0" />
  </ItemGroup>
</Project>
